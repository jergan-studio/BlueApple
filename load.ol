# BlueApple OS Loader configuration
# LO = Local Mode (default for VS Code development and QEMU)
# M1 = USB Live Mode (temporary session; no internal-disk writes)
# M2 = Machine Mode (dedicated-machine boot; no automatic installation)
mode = LO

# Allowed frame targets: 50, 100, or 150
fps = 100

# Local profile name shown in Orbit UI
username = GUEST
